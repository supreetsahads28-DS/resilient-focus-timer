diff --git a/app.py b/app.py
index ca406c3..011939c 100644
--- a/app.py
+++ b/app.py
@@ -775,6 +775,31 @@ def render_react():
 def serve_assets(filename):
     return send_from_directory(os.path.join(BASE_DIR, 'frontend', 'dist', 'assets'), filename)
 
+@app.route('/manifest.webmanifest')
+def serve_manifest():
+    return send_from_directory(
+        os.path.join(BASE_DIR, 'frontend', 'dist'),
+        'manifest.webmanifest',
+        mimetype='application/manifest+json'
+    )
+
+@app.route('/sw.js')
+def serve_service_worker():
+    response = make_response(send_from_directory(
+        os.path.join(BASE_DIR, 'frontend', 'dist'),
+        'sw.js',
+        mimetype='application/javascript'
+    ))
+    # Never let a stale service worker script get cached — browsers already
+    # re-check it on every navigation, but an intermediary cache could hide
+    # updates for a long time otherwise.
+    response.headers['Cache-Control'] = 'no-cache'
+    return response
+
+@app.route('/icons/<path:filename>')
+def serve_icons(filename):
+    return send_from_directory(os.path.join(BASE_DIR, 'frontend', 'dist', 'icons'), filename)
+
 @app.route('/history')
 def history():
     return render_react()
